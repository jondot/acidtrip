source: crates/acidtrip-io/tests/format_exports.rs
expression: "text(Format::React, &o)"
---
// Tiny <test>: 6x2 text-mode art. Generated by acidtrip.
import * as React from "react";

const COLORS: string[] = ["#aaaaaa", "#ff5555", "#0000aa", "#ffff55", "#55ff55", "#aa0000", "#ffffff", "#00aaaa", "#5555ff"];

// One entry per line: [text, fg, bg] runs (bg -1 = transparent).
const LINES: [string, number, number][][] = [
  [["A", 1, 2], ["█", 3, -1], ["▀", 4, 5], ["<&", 6, -1]],
  [[" ", 0, -1], ["░", 7, 8]]
];

const FONT = "\"Perfect DOS VGA 437\", \"Px437 IBM VGA 8x16\", \"Px437 IBM VGA8\", Consolas, Menlo, \"DejaVu Sans Mono\", monospace";

export function AcidArt(props: { className?: string; scale?: number; style?: React.CSSProperties }) {
  const scale = props.scale ?? 1;
  const style: React.CSSProperties = {
    margin: 0,
    display: "inline-block",
    color: COLORS[0],
    background: "#000000",
    fontFamily: FONT,
    fontSize: `${16 * scale}px`,
    lineHeight: 1,
    letterSpacing: 0,
    whiteSpace: "pre",
    ...props.style,
  };
  return (
    <pre className={props.className} style={style} aria-label={"Tiny <test>"}>
      {LINES.map((runs, y) => (
        <React.Fragment key={y}>
          {runs.map(([text, fg, bg], i) => (
            <span key={i} style={{ color: COLORS[fg], background: bg < 0 ? undefined : COLORS[bg] }}>
              {text}
            </span>
          ))}
          {"\n"}
        </React.Fragment>
      ))}
    </pre>
  );
}

export default AcidArt;
