---
// A screenshot at full size: click any .shot. Click again or Esc to close.
---
<div id="zoom" hidden role="dialog" aria-modal="true" aria-label="Screenshot">
  <div class="ph"><span id="zoom-name">shot.png</span><button id="zoom-close" data-tip="Close" data-key="Esc">× close</button></div>
  <div class="view"><img alt="" /></div>
  <div class="cap"></div>
</div>
