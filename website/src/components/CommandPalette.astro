---
// Ctrl-K: fuzzy search over every page, every doc heading and a few
// commands. The index is built here, at build time.
import type { Page } from '../lib/site';
interface Props { pages: Page[] }
const { pages } = Astro.props;
const index = pages.flatMap((p) => [
  { label: 'Open ' + p.file, hint: p.desc, href: p.href },
  ...p.sections.map((s) => ({ label: `${p.name} › ${s.label}`, hint: p.file, href: `${p.href}#${s.id}` })),
]);
---
<div id="pal-dlg" hidden>
  <div id="pal-box" role="dialog" aria-modal="true" aria-label="Commands">
    <div class="ph"><span>Commands</span><span>esc close</span></div>
    <input id="pal-in" autocomplete="off" spellcheck="false" placeholder="type to search pages, docs and commands" aria-controls="pal-list" />
    <ul id="pal-list" role="listbox"></ul>
    <div id="pal-foot">↑↓ move · enter open · esc close</div>
  </div>
</div>
<script type="application/json" id="search-index" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
